get_filename_component(dir "${OUT}" DIRECTORY)
set(set "${dir}/xbased.iconset")
file(REMOVE_RECURSE "${set}")
file(MAKE_DIRECTORY "${set}")
foreach(s 16 32 128 256 512)
  math(EXPR s2 "${s} * 2")
  execute_process(COMMAND sips -z ${s} ${s} "${SRC}" --out "${set}/icon_${s}x${s}.png" OUTPUT_QUIET ERROR_QUIET)
  execute_process(COMMAND sips -z ${s2} ${s2} "${SRC}" --out "${set}/icon_${s}x${s}@2x.png" OUTPUT_QUIET ERROR_QUIET)
endforeach()
execute_process(COMMAND iconutil -c icns "${set}" -o "${OUT}" RESULT_VARIABLE r)
if(NOT r EQUAL 0)
  message(FATAL_ERROR "iconutil failed (${r})")
endif()
file(REMOVE_RECURSE "${set}")
